{
  "name": "@sheska/obsidian-plugin",
  "version": "1.5.0",
  "private": true,
  "description": "Obsidian plugin for Sheska API",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config eslint/config.mjs \"src/**/*.ts\" --fix",
    "lint:check": "eslint --config eslint/config.mjs \"src/**/*.ts\"",
    "deps:check": "depcruise src --config dependency-cruiser/config.cjs",
    "harness:static": "pnpm typecheck && pnpm lint:check && pnpm deps:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sheska/contract": "workspace:*",
    "obsidian": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "builtin-modules": "^4.0.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
