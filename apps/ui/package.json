{
  "name": "@sheska/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/generate-theme-css.mjs --check && eslint --config eslint/config.mjs \"{src,test,scripts}/**/*.{ts,tsx}\" && depcruise src test --config dependency-cruiser/config.cjs",
    "format": "eslint --config eslint/config.mjs \"{src,test,scripts}/**/*.{ts,tsx}\" --fix",
    "test:unit": "vitest run --project unit",
    "test:lint": "vitest run --project lint",
    "test:browser": "vitest run --project browser",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "tokens:build": "node scripts/generate-theme-css.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sheska/contract": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "mdast-util-to-string": "^4.0.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "wanted-sans": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
