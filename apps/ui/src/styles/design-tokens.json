{
  "$description": "Ember & Ash implementation tokens for apps/ui. Only tokens the code references are kept.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0627, 0.0745, 0.098],
        "hex": "#101319"
      }
    },
    "surface-container-lowest": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0431, 0.0549, 0.0784],
        "hex": "#0b0e14"
      }
    },
    "surface-container-low": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.098, 0.1098, 0.1333],
        "hex": "#191c22"
      }
    },
    "surface-container-high": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1529, 0.1647, 0.1882],
        "hex": "#272a30"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8824, 0.8863, 0.9176],
        "hex": "#e1e2ea"
      }
    },
    "outline-variant": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3373, 0.2588, 0.2588],
        "hex": "#564242"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.702, 0.7137],
        "hex": "#ffb3b6"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7647, 0.7765, 0.8196],
        "hex": "#c3c6d1"
      }
    },
    "on-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1725, 0.1882, 0.2235],
        "hex": "#2c3039"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7529, 0.7804, 0.8314],
        "hex": "#c0c7d4"
      }
    },
    "error-container": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5765, 0, 0.0392],
        "hex": "#93000a"
      }
    },
    "on-error-container": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.8549, 0.8392],
        "hex": "#ffdad6"
      }
    },
    "surface-variant": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1961, 0.2078, 0.2314],
        "hex": "#32353b"
      }
    },
    "page-background": {
      "$description": "Current light page background used by implemented routes.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "accent": {
      "$description": "Interactive rose accent used by current implemented routes.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8824, 0.4275, 0.4627],
        "hex": "#e16d76"
      }
    },
    "accent-hover": {
      "$description": "Hover ink for the wordmark and footer links. Same value as accent-strong.",
      "$value": "{color.accent-strong}"
    },
    "accent-strong": {
      "$description": "Accent for small text and for fills that carry white text (6.46:1 both ways). Use accent itself for 24px+ text, borders, focus rings, and anything on a dark surface.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6314, 0.2353, 0.2745],
        "hex": "#a13c46"
      }
    },
    "text-primary": {
      "$value": "{color.surface}"
    },
    "text-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2627, 0.2784, 0.3098],
        "hex": "#43474f"
      }
    },
    "text-muted": {
      "$description": "Low-emphasis label ink on page-background (5.04:1). Previously an alias of on-surface-variant, a dark-theme ink that measured 1.7:1 here.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4196, 0.4353, 0.4706],
        "hex": "#6b6f78"
      }
    },
    "terminal-red": {
      "$description": "MacOS terminal control color used only for terminal chrome.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3725, 0.3412],
        "hex": "#ff5f57"
      }
    },
    "terminal-yellow": {
      "$description": "MacOS terminal control color used only for terminal chrome.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.7412, 0.1804],
        "hex": "#ffbd2e"
      }
    },
    "terminal-green": {
      "$description": "MacOS terminal control color used only for terminal chrome.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1529, 0.7882, 0.2471],
        "hex": "#27c93f"
      }
    }
  },
  "typography": {
    "font-family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Geist", "Arial", "sans-serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "monospace"]
      }
    },
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.sans}",
        "fontSize": "48px",
        "fontWeight": "700",
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em"
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.sans}",
        "fontSize": "24px",
        "fontWeight": "600",
        "lineHeight": "1.3"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.sans}",
        "fontSize": "18px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.sans}",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.mono}",
        "fontSize": "12px",
        "fontWeight": "500",
        "lineHeight": "1.3333333333",
        "letterSpacing": "0.1em"
      },
      "$description": "The uppercase mono label idiom. Values match what the components shipped as text-xs + tracking-widest, so text-label-sm renders identically."
    },
    "code-snippet": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.mono}",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "1.5"
      }
    },
    "display-terminal": {
      "$description": "Terminal prompt/body text. Intentionally smaller than the current Stitch export (24px); Stitch has not been updated to match.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.mono}",
        "fontSize": "18px",
        "fontWeight": "500",
        "lineHeight": "1.6"
      }
    },
    "display-terminal-mobile": {
      "$description": "Terminal prompt/body text on mobile viewports.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.font-family.mono}",
        "fontSize": "14px",
        "fontWeight": "500",
        "lineHeight": "1.6"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.125rem"
    },
    "default": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "unit": {
      "$value": "4px"
    },
    "gutter": {
      "$value": "24px"
    },
    "margin-mobile": {
      "$value": "16px"
    },
    "margin-desktop": {
      "$value": "64px"
    },
    "container-max": {
      "$value": "1280px"
    },
    "container-terminal": {
      "$description": "Terminal hero container max width. Intentionally wider than the current Stitch export (1000px); Stitch has not been updated to match.",
      "$value": "1100px"
    }
  }
}
