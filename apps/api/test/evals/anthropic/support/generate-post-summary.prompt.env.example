# Copy to generate-post-summary.prompt.env (gitignored) and fill in every value except the name.
# Paths are relative to apps/api.

# Optional. Defaults to "generate-post-summary <model> <effort>".
EVAL_POST_SUMMARY_NAME=

# claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5
EVAL_POST_SUMMARY_MODEL=

# low | medium | high
EVAL_POST_SUMMARY_EFFORT=

# Includes thinking tokens.
EVAL_POST_SUMMARY_MAX_OUTPUT_TOKENS=

# A *.local.md file is gitignored, e.g. test/evals/anthropic/support/instructions.local.md
EVAL_POST_SUMMARY_INSTRUCTIONS_FILE=
