{
  "name": "@sheska/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc --project tsconfig.migrate.json && tsc-alias --project tsconfig.migrate.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_ENV=development nest start --env-file .env.development",
    "start:dev": "NODE_ENV=development nest start --watch --env-file .env.development",
    "start:debug": "NODE_ENV=development nest start --debug --watch --env-file .env.development",
    "lint": "eslint --config eslint/config.mjs \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint --config eslint/config.mjs \"{src,test}/**/*.ts\"",
    "deps:check": "depcruise src test --config dependency-cruiser/config.cjs",
    "deps:graph": "depcruise src test --config dependency-cruiser/config.cjs --output-type mermaid --output-to dependency-graph.mmd",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "NODE_ENV=development node --env-file=.env.development -r ts-node/register -r tsconfig-paths/register database/migrate.ts",
    "db:reset": "NODE_ENV=development node --env-file=.env.development -r ts-node/register -r tsconfig-paths/register database/reset.ts",
    "db:seed": "NODE_ENV=development node --env-file=.env.development -r ts-node/register -r tsconfig-paths/register database/seed.ts",
    "harness:static": "pnpm typecheck && pnpm lint:check && pnpm deps:check && pnpm test:integration:static",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration:all",
    "test:unit": "vitest run --project unit",
    "test:integration:static": "vitest run --project static",
    "test:integration:in-process": "vitest run --project in-process",
    "test:integration:postgres": "vitest run --project postgres",
    "test:integration:redis": "vitest run --project redis",
    "test:integration:ollama": "vitest run --project ollama",
    "test:integration:all": "pnpm test:integration:in-process && pnpm test:integration:postgres && pnpm test:integration:redis && pnpm test:integration:ollama",
    "test:runtime:start": "NODE_ENV=test ts-node --project tsconfig.json -r tsconfig-paths/register test/runtime/start.ts",
    "test:runtime:stop": "NODE_ENV=test ts-node --project tsconfig.json -r tsconfig-paths/register test/runtime/stop.ts",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.11",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@sheska/contract": "workspace:*",
    "bullmq": "^5.81.5",
    "bullmq-otel": "^1.3.1",
    "cookie": "^1.1.1",
    "drizzle-orm": "1.0.0-beta.22",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-std-serializers": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
