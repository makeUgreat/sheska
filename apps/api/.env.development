# 저장소에 커밋하는 파일이다. 자기 PC의 local 환경에서만 쓰는 값이라 새어도 이 값으로 접근할 수 있는 곳이 없다.
# production의 값, 실제 서비스의 비밀번호와 API 키는 이 파일에 절대 넣지 않는다.

DATABASE_URL=postgres://sheska:sheska@127.0.0.1:5432/sheska
REDIS_URL=redis://127.0.0.1:6379

EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Obsidian 앱, Vite 개발 서버 순서다. UI는 Vite proxy로 같은 출처에서 호출하지만 직접 호출할 때를 위해 둔다.
CORS_ORIGINS=app://obsidian.md,http://localhost:5173
LOG_FORMAT=pretty

# hash-infra의 공용 Alloy를 VPN으로 쓴다. VPN이 끊겨 있으면 전송만 실패한다.
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.8.0.1:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
