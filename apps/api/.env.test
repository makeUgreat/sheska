# 저장소에 커밋하는 파일이다. 자동 테스트에서만 쓰는 값이라 새어도 이 값으로 접근할 수 있는 곳이 없다.
# production의 값, 실제 서비스의 비밀번호와 API 키는 이 파일에 절대 넣지 않는다.

DATABASE_URL=postgres://sheska:sheska@127.0.0.1:56432/sheska_test
REDIS_URL=redis://127.0.0.1:56379
EMBEDDING_BASE_URL=http://127.0.0.1:3002
ATTACHMENT_STORAGE_ENDPOINT=http://attachment-storage-unavailable:9000
ATTACHMENT_STORAGE_BUCKET=sheska-attachments
ATTACHMENT_STORAGE_ACCESS_KEY_ID=unused
ATTACHMENT_STORAGE_SECRET_ACCESS_KEY=unused
CORS_ORIGINS=http://localhost:4173
OWNER_PASSWORD=test-owner-password
