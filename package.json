{
  "name": "sheska",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "deps:check": "depcruise apps --config .dependency-cruiser.cjs",
    "rules:check": "nocap --spec \"docs/ko/domain/*.md\" --test \"apps/*/{src,test,scripts}/**/*{.spec,-spec}.{ts,tsx}\" --test \"e2e/tests/**/*.spec.ts\"",
    "harness:static": "pnpm deps:check && pnpm -r --if-present harness:static",
    "harness:build": "pnpm -r build && pnpm --filter @sheska/api test:runtime:start && pnpm --filter @sheska/api test:runtime:stop"
  },
  "devDependencies": {
    "@makehash/nocap": "^0.3.0",
    "dependency-cruiser": "^17.4.2"
  }
}
