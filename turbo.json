{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "main.js"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "//#lint": {},
    "test": {
      "dependsOn": ["test:unit", "test:http", "test:app", "test:logger", "test:image", "test:lint", "test:pages"]
    },
    "test:unit": { "dependsOn": ["^build"] },
    "test:http": { "dependsOn": ["^build"] },
    "test:app": { "dependsOn": ["^build"] },
    "test:logger": { "dependsOn": ["^build"] },
    "test:image": { "dependsOn": ["^build"] },
    "test:lint": { "dependsOn": ["^build"] },
    "test:pages": { "dependsOn": ["^build"] },
    "test:postgres": { "dependsOn": ["^build"] },
    "test:redis": { "dependsOn": ["^build"] },
    "test:runtime": { "dependsOn": ["^build"] },
    "test:browser": { "dependsOn": ["^build"] },
    "test:ollama": { "dependsOn": ["^build"], "cache": false }
  }
}
